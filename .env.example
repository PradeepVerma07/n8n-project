# -----------------------------------------------------------------------------
# APPLICATION CORE
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL 16)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postpilot:postpilot_secret@localhost:5432/postpilot?schema=public

# -----------------------------------------------------------------------------
# CACHE & QUEUES (Redis 7)
# -----------------------------------------------------------------------------
REDIS_URL=redis://:redis_secret@localhost:6379/0

# -----------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# -----------------------------------------------------------------------------
JWT_SECRET=super_secret_jwt_access_key_at_least_32_characters_long_12345
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_at_least_32_characters_long_67890
JWT_REFRESH_EXPIRY=7d

# AES-256-GCM Master Key (Must be 32 bytes = 64 hex characters)
# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth (Optional SSO)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# -----------------------------------------------------------------------------
# OBJECT STORAGE (S3 / Cloudflare R2 / MinIO for Local Dev)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=postpilot-media
S3_PUBLIC_URL=http://localhost:9000/postpilot-media
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# AUTOMATION & N8N ORCHESTRATION
# -----------------------------------------------------------------------------
# Shared API key used by n8n to call Node.js API endpoints
POSTPILOT_API_KEY=pp_live_secret_n8n_scheduler_api_key_123456

# HMAC Secret used to sign and verify webhooks between Node API and n8n
N8N_HMAC_SECRET=hmac_shared_secret_between_node_and_n8n_at_least_32_chars

# n8n Webhook URL for publish results callback (WF-02)
N8N_PUBLISH_RESULT_WEBHOOK_URL=http://localhost:5678/webhook/publish-result

# -----------------------------------------------------------------------------
# PUBLISHER SETTINGS
# -----------------------------------------------------------------------------
# mock: Simulates API calls without real platform credentials (ideal for dev/demo)
# live: Executes real platform API calls
PUBLISH_MODE=mock

# -----------------------------------------------------------------------------
# GOOGLE SERVICE ACCOUNT (Google Sheets API v4)
# -----------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Formatted private key with \n
GOOGLE_PRIVATE_KEY=
