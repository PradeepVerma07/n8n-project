datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  AGENCY_ADMIN
  BRAND_MANAGER
  CONTENT_CREATOR
  CLIENT_VIEWER
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  TWITTER
  YOUTUBE
  TIKTOK
  PINTEREST
  GOOGLE_BUSINESS
}

enum PostType {
  IMAGE
  VIDEO
  CAROUSEL
  TEXT
  REEL
  SHORT
  STORY
}

enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  QUEUED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
  CANCELLED
}

enum PlatformPublishStatus {
  PENDING
  QUEUED
  PUBLISHING
  SUCCESS
  FAILED
  SKIPPED
}

enum PostSource {
  DASHBOARD
  SHEET
  API
}

enum AccountStatus {
  CONNECTED
  EXPIRING_SOON
  EXPIRED
  REVOKED
  ERROR
}

enum ErrorCode {
  AUTH_EXPIRED
  RATE_LIMITED
  MEDIA_INVALID
  MEDIA_PROCESSING_TIMEOUT
  PERMISSION_DENIED
  DUPLICATE_CONTENT
  PLATFORM_ERROR
  MISSED_WINDOW
  UNKNOWN
}

// -----------------------------------------------------------------------------
// ORGANIZATIONS & USERS (Multi-Tenant & RBAC)
// -----------------------------------------------------------------------------

model Organization {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar(255)
  slug            String           @unique @db.VarChar(100)
  logoUrl         String?          @map("logo_url")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  memberships     Membership[]
  brands          Brand[]
  apiKeys         ApiKey[]
  mediaAssets     MediaAsset[]
  auditLogs       AuditLog[]

  @@map("organizations")
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique @db.VarChar(255)
  passwordHash    String?          @map("password_hash") @db.VarChar(255)
  firstName       String           @map("first_name") @db.VarChar(100)
  lastName        String           @map("last_name") @db.VarChar(100)
  avatarUrl       String?          @map("avatar_url")
  googleId        String?          @unique @map("google_id")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  memberships     Membership[]
  refreshTokens   RefreshToken[]
  createdPosts    Post[]           @relation("PostCreator")
  approvedPosts   Post[]           @relation("PostApprover")
  auditLogs       AuditLog[]
  notifications   Notification[]

  @@map("users")
}

model Membership {
  id              String           @id @default(uuid()) @db.Uuid
  orgId           String           @map("org_id") @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  role            UserRole         @default(CONTENT_CREATOR)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@index([orgId, role])
  @@map("memberships")
}

model RefreshToken {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  tokenHash       String           @unique @map("token_hash")
  expiresAt       DateTime         @map("expires_at")
  revokedAt       DateTime?        @map("revoked_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model ApiKey {
  id              String           @id @default(uuid()) @db.Uuid
  orgId           String           @map("org_id") @db.Uuid
  name            String           @db.VarChar(100)
  keyHash         String           @unique @map("key_hash")
  keyPrefix       String           @map("key_prefix") @db.VarChar(16)
  lastUsedAt      DateTime?        @map("last_used_at")
  expiresAt       DateTime?        @map("expires_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  organization    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("api_keys")
}

// -----------------------------------------------------------------------------
// BRANDS & SOCIAL ACCOUNTS
// -----------------------------------------------------------------------------

model Brand {
  id                  String           @id @default(uuid()) @db.Uuid
  orgId               String           @map("org_id") @db.Uuid
  name                String           @db.VarChar(255)
  slug                String           @db.VarChar(100)
  logoUrl             String?          @map("logo_url")
  primaryColor        String?          @map("primary_color") @db.VarChar(20)
  defaultTimezone     String           @default("Asia/Kolkata") @map("default_timezone") @db.VarChar(100)
  defaultHashtags     String?          @map("default_hashtags")
  requiresApproval    Boolean          @default(false) @map("requires_approval")
  autoPublishMissed   Boolean          @default(false) @map("auto_publish_missed")
  lookbackMinutes     Int              @default(10) @map("lookback_minutes")
  isActive            Boolean          @default(true) @map("is_active")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  organization        Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sheetConfig         SheetConfig?
  socialAccounts      SocialAccount[]
  posts               Post[]
  reports             Report[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([isActive])
  @@map("brands")
}

model SheetConfig {
  id                  String           @id @default(uuid()) @db.Uuid
  brandId             String           @unique @map("brand_id") @db.Uuid
  scheduleSpreadsheetId String         @map("schedule_spreadsheet_id") @db.VarChar(255)
  scheduleSheetName   String           @default("Schedule") @map("schedule_sheet_name") @db.VarChar(100)
  reportSpreadsheetId String?          @map("report_spreadsheet_id") @db.VarChar(255)
  reportSheetPrefix   String           @default("Report_") @map("report_sheet_prefix") @db.VarChar(50)
  lastSyncAt          DateTime?        @map("last_sync_at")
  lastSyncRowChecksum String?          @map("last_sync_row_checksum")
  syncStatus          String           @default("IDLE") @map("sync_status") @db.VarChar(50)
  syncError           String?          @map("sync_error")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  brand               Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@map("sheets_config")
}

model SocialAccount {
  id                  String           @id @default(uuid()) @db.Uuid
  brandId             String           @map("brand_id") @db.Uuid
  platform            Platform
  platformAccountId   String           @map("platform_account_id") @db.VarChar(255)
  accountName         String           @map("account_name") @db.VarChar(255)
  accountHandle       String?          @map("account_handle") @db.VarChar(255)
  avatarUrl           String?          @map("avatar_url")
  accessTokenEncrypted String          @map("access_token_encrypted")
  refreshTokenEncrypted String?         @map("refresh_token_encrypted")
  tokenIv             String           @map("token_iv") @db.VarChar(64)
  tokenTag            String           @map("token_tag") @db.VarChar(64)
  expiresAt           DateTime?        @map("expires_at")
  scopes              String[]
  metadata            Json?            @default("{}")
  status              AccountStatus    @default(CONNECTED)
  lastHealthCheckAt   DateTime?        @map("last_health_check_at")
  healthErrorMessage  String?          @map("health_error_message")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  brand               Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platformPosts       PostPlatform[]

  @@unique([brandId, platform, platformAccountId])
  @@index([brandId])
  @@index([status, expiresAt])
  @@map("social_accounts")
}

// -----------------------------------------------------------------------------
// MEDIA ASSETS
// -----------------------------------------------------------------------------

model MediaAsset {
  id              String           @id @default(uuid()) @db.Uuid
  orgId           String           @map("org_id") @db.Uuid
  s3Key           String           @unique @map("s3_key")
  publicUrl       String           @map("public_url")
  originalFilename String          @map("original_filename") @db.VarChar(255)
  mimeType        String           @map("mime_type") @db.VarChar(100)
  fileSize        BigInt           @map("file_size")
  checksumSha256  String           @map("checksum_sha256") @db.VarChar(64)
  width           Int?
  height          Int?
  durationSeconds Float?           @map("duration_seconds")
  thumbnailUrl    String?          @map("thumbnail_url")
  metadata        Json?            @default("{}")
  createdAt       DateTime         @default(now()) @map("created_at")

  organization    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([checksumSha256])
  @@map("media_assets")
}

// -----------------------------------------------------------------------------
// POSTS & PLATFORMS
// -----------------------------------------------------------------------------

model Post {
  id              String           @id @default(uuid()) @db.Uuid
  customId        String           @unique @map("custom_id") @db.VarChar(100)
  brandId         String           @map("brand_id") @db.Uuid
  createdById     String?          @map("created_by_id") @db.Uuid
  approvedById    String?          @map("approved_by_id") @db.Uuid
  source          PostSource       @default(DASHBOARD)
  topic           String?          @db.VarChar(255)
  caption         String           @db.Text
  hashtags        String?          @db.Text
  firstComment    String?          @map("first_comment") @db.Text
  linkUrl         String?          @map("link_url")
  postType        PostType         @map("post_type")
  mediaUrls       String[]         @map("media_urls")
  
  scheduledLocal  DateTime         @map("scheduled_local")
  timezone        String           @map("timezone") @db.VarChar(100)
  scheduledUtc    DateTime         @map("scheduled_utc")
  publishedAtUtc  DateTime?        @map("published_at_utc")
  
  status          PostStatus       @default(DRAFT)
  sheetRowIndex   Int?             @map("sheet_row_index")
  lastUpdatedBy   String?          @map("last_updated_by") @db.VarChar(255)
  rejectionReason String?          @map("rejection_reason")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  brand           Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("PostCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy      User?            @relation("PostApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  platforms       PostPlatform[]
  publishJobs     PublishJob[]
  reports         Report[]

  @@index([brandId])
  @@index([scheduledUtc, status])
  @@index([status])
  @@map("posts")
}

model PostPlatform {
  id                  String                @id @default(uuid()) @db.Uuid
  postId              String                @map("post_id") @db.Uuid
  socialAccountId     String?               @map("social_account_id") @db.Uuid
  platform            Platform
  captionOverride     String?               @map("caption_override") @db.Text
  firstCommentOverride String?              @map("first_comment_override") @db.Text
  status              PlatformPublishStatus @default(PENDING)
  platformPostId      String?               @map("platform_post_id") @db.VarChar(255)
  platformPostUrl     String?               @map("platform_post_url")
  attempts            Int                   @default(0)
  maxAttempts         Int                   @default(5) @map("max_attempts")
  errorCode           ErrorCode?            @map("error_code")
  errorMessage        String?               @map("error_message")
  publishedAtUtc      DateTime?             @map("published_at_utc")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  post                Post                  @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount       SocialAccount?        @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  @@unique([postId, platform])
  @@index([platform, status])
  @@map("post_platforms")
}

// -----------------------------------------------------------------------------
// IDEMPOTENCY & QUEUE PUBLISH JOBS
// -----------------------------------------------------------------------------

model PublishJob {
  id              String           @id @default(uuid()) @db.Uuid
  idempotencyKey  String           @unique @map("idempotency_key")
  postId          String           @map("post_id") @db.Uuid
  platform        Platform
  status          String           @default("ENQUEUED") @db.VarChar(50)
  bullmqJobId     String?          @map("bullmq_job_id") @db.VarChar(100)
  workerId        String?          @map("worker_id") @db.VarChar(100)
  startedAt       DateTime?        @map("started_at")
  completedAt     DateTime?        @map("completed_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  post            Post             @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("publish_jobs")
}

// -----------------------------------------------------------------------------
// REPORTS & ANALYTICS (Denormalized)
// -----------------------------------------------------------------------------

model Report {
  id               String           @id @default(uuid()) @db.Uuid
  customId         String           @map("custom_id") @db.VarChar(100)
  postId           String           @map("post_id") @db.Uuid
  brandId          String           @map("brand_id") @db.Uuid
  clientName       String           @map("client_name") @db.VarChar(255)
  topic            String?          @db.VarChar(255)
  platform         Platform
  postType         PostType         @map("post_type")
  scheduledLocal   DateTime         @map("scheduled_local")
  timezone         String           @db.VarChar(100)
  scheduledUtc     DateTime         @map("scheduled_utc")
  attemptedAtUtc   DateTime         @map("attempted_at_utc")
  publishedAtUtc   DateTime?        @map("published_at_utc")
  status           String           @db.VarChar(50)
  attempts         Int
  platformPostId   String?          @map("platform_post_id") @db.VarChar(255)
  platformPostUrl  String?          @map("platform_post_url")
  errorCode        ErrorCode?       @map("error_code")
  errorMessage     String?          @map("error_message")
  latencySeconds   Float?           @map("latency_seconds")
  sheetSyncStatus  Boolean          @default(false) @map("sheet_sync_status")
  createdAt        DateTime         @default(now()) @map("created_at")

  post             Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  brand            Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId, scheduledUtc])
  @@index([platform, status])
  @@index([createdAt])
  @@map("reports")
}

// -----------------------------------------------------------------------------
// AUDIT LOGS & NOTIFICATIONS
// -----------------------------------------------------------------------------

model AuditLog {
  id              String           @id @default(uuid()) @db.Uuid
  orgId           String           @map("org_id") @db.Uuid
  userId          String?          @map("user_id") @db.Uuid
  action          String           @db.VarChar(100)
  entityType      String           @map("entity_type") @db.VarChar(50)
  entityId        String           @map("entity_id") @db.VarChar(100)
  ipAddress       String?          @map("ip_address") @db.VarChar(45)
  userAgent       String?          @map("user_agent")
  beforeState     Json?            @map("before_state")
  afterState      Json?            @map("after_state")
  createdAt       DateTime         @default(now()) @map("created_at")

  organization    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  title           String           @db.VarChar(255)
  message         String           @db.Text
  type            String           @db.VarChar(50)
  isRead          Boolean          @default(false) @map("is_read")
  linkUrl         String?          @map("link_url")
  createdAt       DateTime         @default(now()) @map("created_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}
